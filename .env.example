# Local: copy to .env and restart `npm run dev`.
# Vercel: Project → Settings → Environment Variables. Same names, for Production
# (and Preview if you use preview deploys). Redeploy after saving.
# Use the Supabase project URL and the anon public key. Do not use the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
